{
  "name": "romantic-wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "links:template": "node scripts/create-link-template.mjs",
    "links:create": "node scripts/create-guest-links.mjs",
    "links:import": "node scripts/import-invitations.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local --var LOCAL_DEVELOPMENT:true",
    "links:examples": "node scripts/create-local-examples.mjs",
    "links:demo": "node scripts/create-public-demo.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "exceljs": "^4.4.0"
  }
}
