{
  "name": "romantic-wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "links:template": "node scripts/create-link-template.mjs",
    "links:create": "node scripts/create-guest-links.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local --persist-to .wrangler/state --var LOCAL_DEVELOPMENT:true",
    "links:seed-local": "node scripts/seed-local-invitations.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
